{
  "sourceLanguage": "en",
  "strings": {
    "+ %@": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "+ %@"
          }
        }
      }
    },
    "%@ (%@)": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@（%2$@）"
          }
        }
      }
    },
    "%@ (%@, used by another app)": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@（%2$@，已被其他 app 占用）"
          }
        }
      }
    },
    "%@ + Double-Click: PiP Area Under Pointer": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ + 双击：PiP 鼠标下方的区域"
          }
        }
      }
    },
    "%@ + double-click needs Accessibility permission. Turn it on in System Settings.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ + 双击需要「辅助功能」权限，请在系统设置中打开"
          }
        }
      }
    },
    "%@ again when in front": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "原窗口在前时再%@"
          }
        }
      }
    },
    "%@ couldn't be registered and isn't active. Choose another combination or relaunch PipDog.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 注册失败，未生效；请换一个组合或重新启动 PipDog"
          }
        }
      }
    },
    "%@ is already used for “%@”": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 已经用于「%2$@」"
          }
        }
      }
    },
    "%@ is granted. Relaunch PipDog for it to take effect.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "「%@」已授权，需要重新启动 PipDog 才能生效"
          }
        }
      }
    },
    "%@ is used by another app and isn't active": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 已被其他 app 占用，未生效"
          }
        }
      }
    },
    "%@: %@": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@：%2$@"
          }
        }
      }
    },
    "About PipDog": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "关于 PipDog"
          }
        }
      }
    },
    "Accessibility": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "辅助功能"
          }
        }
      }
    },
    "Accessibility granted. %@ + double-click is ready.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "辅助功能已授权，%@ + 双击可以用了"
          }
        }
      }
    },
    "Accessibility was turned off. %@ + double-click now only observes, and the second click goes through to the app. Turn PipDog back on in System Settings › Privacy & Security › Accessibility to restore it.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "辅助功能权限已关闭，%@ + 双击暂时只能旁观，第二次点击会照常传给目标 app。在「系统设置 › 隐私与安全性 › 辅助功能」里重新打开 PipDog 即可恢复"
          }
        }
      }
    },
    "Accessibility: Granted": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "辅助功能：已授权"
          }
        }
      }
    },
    "Accessibility: Not Granted (needed for edge parking, modifier + double-click and Enhanced Mode)": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "辅助功能：未授权（移到屏幕边上、修饰键 + 双击、增强模式需要）"
          }
        }
      }
    },
    "After relaunching, PipDog can capture window content.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "重新启动后即可抓取窗口画面。"
          }
        }
      }
    },
    "Allow PipDog in System Settings › General › Login Items & Extensions so it opens at login": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请在「系统设置 › 通用 › 登录项与扩展」里允许 PipDog，开机时才会启动"
          }
        }
      }
    },
    "Brings the source window to the front; again while it's in front parks it at the screen edge.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "把原窗口切到前面；原窗口已在最前时再点一次，把它移到屏幕边上。"
          }
        }
      }
    },
    "Can't capture this window of “%@”": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法抓取「%@」的这个窗口"
          }
        }
      }
    },
    "Can't move the window of “%@” (it's full screen, or the app doesn't allow it). Exit full screen and try again.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法移动「%@」的窗口（全屏窗口或这个 app 不允许移动窗口），可以先退出全屏再试"
          }
        }
      }
    },
    "Cancel": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "取消"
          }
        }
      }
    },
    "Capture": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "画面"
          }
        }
      }
    },
    "Clear Shortcut": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "清除快捷键"
          }
        }
      }
    },
    "Click": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "单击"
          }
        }
      }
    },
    "Click a shortcut, then press a new combination with ⌘, ⌃ or ⌥. Cleared actions stay in the menu.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点击快捷键后按下新的组合，需包含 ⌘、⌃ 或 ⌥。清除后仍可从菜单使用。"
          }
        }
      }
    },
    "Click to Record": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点击录制"
          }
        }
      }
    },
    "Close": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "关闭"
          }
        }
      }
    },
    "Close All PiPs": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "关闭所有 PiP"
          }
        }
      }
    },
    "Close PiP": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "关闭小窗"
          }
        }
      }
    },
    "Close This PiP": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "关闭这个 PiP"
          }
        }
      }
    },
    "Couldn't %@ Open at Login. Try again later, or set it in System Settings › General › Login Items & Extensions.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法%@开机时启动，请稍后再试，或在「系统设置 › 通用 › 登录项与扩展」里手动设置"
          }
        }
      }
    },
    "Couldn't %@ Open at Login: PipDog's signature is invalid. Use an officially installed copy.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法%@开机时启动：PipDog 的签名无效，请使用正式安装的版本"
          }
        }
      }
    },
    "Couldn't %@ Open at Login: macOS denied it. Allow PipDog in System Settings › General › Login Items & Extensions.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法%@开机时启动：被系统拒绝，请在「系统设置 › 通用 › 登录项与扩展」里允许 PipDog"
          }
        }
      }
    },
    "Couldn't %@ Open at Login: no permission to change login items.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法%@开机时启动：没有修改登录项的权限"
          }
        }
      }
    },
    "Couldn't %@ Open at Login: the login items service isn't available right now. Try again later.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法%@开机时启动：登录项服务暂时不可用，请稍后再试"
          }
        }
      }
    },
    "Couldn't find an app to register. Move PipDog to the Applications folder and open it again.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "找不到可登记的应用，请先把 PipDog 装到「应用程序」文件夹再打开"
          }
        }
      }
    },
    "Couldn't move the window of “%@” back. Click the PiP to try again, or drag the window back yourself.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法把「%@」的窗口移回原位，可以再单击小窗重试，或手动把窗口拖回来"
          }
        }
      }
    },
    "Couldn't move the window of “%@” back. Double-click the PiP to try again, or drag the window back yourself.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法把「%@」的窗口移回原位，可以再双击小窗重试，或手动把窗口拖回来"
          }
        }
      }
    },
    "Couldn't open System Settings. Go to Privacy & Security › %@ manually.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法打开系统设置，请手动前往「隐私与安全性 › %@」"
          }
        }
      }
    },
    "Couldn't relaunch PipDog. Quit PipDog from the menu and open it again.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "重新启动 PipDog 失败，请从菜单退出 PipDog 后再手动打开"
          }
        }
      }
    },
    "Couldn't resume “%@”. Click the PiP to try again.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法恢复「%@」的画面，请再单击小窗重试"
          }
        }
      }
    },
    "Couldn't resume “%@”. Double-click the PiP to try again.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法恢复「%@」的画面，请再双击小窗重试"
          }
        }
      }
    },
    "Couldn't save the snapshot": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法保存截图"
          }
        }
      }
    },
    "Couldn't show “%@”": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法显示「%@」"
          }
        }
      }
    },
    "Couldn't start PiP: this window can't be captured right now. Try again later.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "启动 PiP 失败：暂时无法抓取这个窗口，请稍后再试"
          }
        }
      }
    },
    "Double-click": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "双击"
          }
        }
      }
    },
    "Drag": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "拖动"
          }
        }
      }
    },
    "Drag bottom-right corner": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "拖右下角"
          }
        }
      }
    },
    "Drag to select a region to PiP. Press Esc or right-click to cancel.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "拖动选择要 PiP 的区域，Esc 或右键取消"
          }
        }
      }
    },
    "Enabled": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "启用"
          }
        }
      }
    },
    "Follow System": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "跟随系统"
          }
        }
      }
    },
    "For edge parking, modifier + double-click and Enhanced Mode; requested when needed": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "把原窗口移到屏幕边上、修饰键 + 双击、增强模式，用到时再引导"
          }
        }
      }
    },
    "Frame Rate": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "帧率"
          }
        }
      }
    },
    "General": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "通用"
          }
        }
      }
    },
    "Get Started": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "开始使用"
          }
        }
      }
    },
    "Global Shortcuts": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "全局快捷键"
          }
        }
      }
    },
    "Global shortcuts aren't available right now; use the menu bar menu instead. Try relaunching PipDog.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "全局快捷键暂时不可用，只能从菜单栏的 PiP 菜单使用；请重新启动 PipDog"
          }
        }
      }
    },
    "Global shortcuts failed to start, so %@ only works from the menu for now. Try relaunching PipDog.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "全局快捷键初始化失败，%@ 暂时只能从菜单使用；请重新启动 PipDog"
          }
        }
      }
    },
    "Granted": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已授权"
          }
        }
      }
    },
    "Granted, Relaunch Required": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已授权，需重新启动"
          }
        }
      }
    },
    "Hide on Hover": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "悬停时自动隐藏"
          }
        }
      }
    },
    "Higher is smoother but uses more CPU; 5–10 fps is plenty for logs and progress bars.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "越高越流畅，也越费 CPU；盯日志、进度条用 5–10 fps 就够了。"
          }
        }
      }
    },
    "Hold": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "需要按住"
          }
        }
      }
    },
    "Include at least one of ⌘, ⌃ or ⌥ (⇧ alone isn't enough)": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "至少要包含 ⌘、⌃ 或 ⌥ 中的一个（只有 ⇧ 不行）"
          }
        }
      }
    },
    "Language": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "语言"
          }
        }
      }
    },
    "Later": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "稍后"
          }
        }
      }
    },
    "Modifier + Double-Click: PiP Area Under Pointer": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "修饰键 + 双击：PiP 鼠标下方的区域"
          }
        }
      }
    },
    "Move / pan": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "移动 / 平移"
          }
        }
      }
    },
