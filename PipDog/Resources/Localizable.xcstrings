      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "开机时启动"
          }
        }
      }
    },
    "Park at edge / bring back": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "停到屏幕边 / 移回"
          }
        }
      }
